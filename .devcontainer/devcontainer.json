{
	"name": "Counterfactuals Dev Environment",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/counterfactuals",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			]
		}
	},
	"postCreateCommand": "bash .devcontainer/setup_envs.sh",
	"remoteUser": "vscode"
}
